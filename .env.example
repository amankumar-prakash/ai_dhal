# Root environment example — DO NOT put real secrets here

# --- api_service only (Supabase is primary store) ---
API_STORE=supabase
DATABASE_URL=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer new secret API key (Settings → API Keys). Legacy service_role JWT still works until disabled.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# User JWTs: verify via JWKS ({SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# Legacy JWT secret is DEPRECATED — only for projects not yet on signing keys:
# SUPABASE_JWT_SECRET=
# Publishable key belongs in secure_dash/.env — never secret/service_role there
# Offline tests may set API_STORE=memory

# --- lab Admin bootstrap (scripts/bootstrap_admin.py) ---
TEST_USERNAME=
TEST_PASSWORD=

# --- service tokens ---
RED_SERVICE_TOKEN=change-me-red
BLUE_SERVICE_TOKEN=change-me-blue
RED_WORKER_URL=http://localhost:8001
BLUE_WORKER_URL=http://localhost:8002

# --- red_team_backend + blue_team_backend (LLM + live tools) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
LLM_STUB=1
HEXSTRIKE_BASE_URL=http://host.docker.internal:8888
HEXSTRIKE_STUB=0
# Sibling CAI repo on the host (Compose mounts at /cai in Kali workers)
CAI_HOST_PATH=/home/kali/workspace/cai_pentesting
# Path inside the worker container (default /cai). Leave empty only for local non-Compose runs.
CAI_WORKDIR=/cai
CAI_STUB=0
# Interactive CAI chat on /tools/red|/tools/blue (uv run cai in CAI_WORKDIR)
CAI_CHAT_STUB=1
# Kali-native uv venv inside the worker (NOT the host-mounted cai_pentesting/.venv)
CAI_CONTAINER_VENV=/var/cache/cai-venv
CAI_AGENT_TYPE=redteam_agent
CAI_AGENT_TYPE_BLUE=bug_bounter_agent
# After Dockerfile changes: docker compose build red_team_backend blue_team_backend
# Then warm CAI: docker compose exec red_team_backend sh -c 'cd /cai && UV_PROJECT_ENVIRONMENT=/var/cache/cai-venv uv sync'

# --- safety ---
DEMO_SAFE_MODE=1
TARGET_ALLOWLIST=

# --- secure_dash (public) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
